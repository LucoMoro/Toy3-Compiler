<Program>
  <VarDecl type='STRING'>
    <VarOptInit name='operazione'>
    </VarOptInit>
  </VarDecl>
  <VarDecl type='DOUBLE'>
    <VarOptInit name='res4'>
    </VarOptInit>
    <VarOptInit name='res3'>
    </VarOptInit>
    <VarOptInit name='res2'>
    </VarOptInit>
    <VarOptInit name='res1'>
    </VarOptInit>
    <VarOptInit name='result'>
    </VarOptInit>
    <VarOptInit name='answer'>
    </VarOptInit>
    <VarOptInit name='input2'>
    </VarOptInit>
    <VarOptInit name='input1'>
    </VarOptInit>
  </VarDecl>
  <VarDecl type='BOOL'>
    <VarOptInit name='flag'>
    </VarOptInit>
  </VarDecl>
  <DefDecl name='somma' type='null'>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='true'  name='result'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input2'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input1'>
      </PVar>
    </ParDecl>
    <Body>
      <AssignNode>
        <IdNode>result</IdNode>
        <AddNode>
          <IdNode>input1</IdNode>
          <IdNode>input2</IdNode>
        </AddNode>
      </AssignNode>
    </Body>
  </DefDecl>
  <DefDecl name='sottrazione' type='null'>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='true'  name='result'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input2'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input1'>
      </PVar>
    </ParDecl>
    <Body>
      <AssignNode>
        <IdNode>result</IdNode>
        <DiffNode>
          <IdNode>input1</IdNode>
          <IdNode>input2</IdNode>
        </DiffNode>
      </AssignNode>
    </Body>
  </DefDecl>
  <DefDecl name='moltiplicazione' type='DOUBLE'>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input2'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input1'>
      </PVar>
    </ParDecl>
    <Body>
      <ReturnNode>
        <MulNode>
          <IdNode>input1</IdNode>
          <IdNode>input2</IdNode>
        </MulNode>
      </ReturnNode>
    </Body>
  </DefDecl>
  <DefDecl name='divisione' type='DOUBLE'>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input2'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input1'>
      </PVar>
    </ParDecl>
    <Body>
      <IfThenNode>
        <EQNode>
          <IdNode>input2</IdNode>
          <IntNode>0</IntNode>
        </EQNode>
        <Body>
          <WriteNode isNewLine='true'>
            <StringNode>Errore: divisione per zero</StringNode>
          </WriteNode>
          <ReturnNode>
            <DoubleNode>0.0</DoubleNode>
          </ReturnNode>
        </Body>
      </IfThenNode>
      <ReturnNode>
        <DivNode>
          <IdNode>input1</IdNode>
          <IdNode>input2</IdNode>
        </DivNode>
      </ReturnNode>
    </Body>
  </DefDecl>
  <DefDecl name='tutteleoperazioni' type='null'>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='true'  name='res4'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='true'  name='res3'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='true'  name='res2'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='true'  name='res1'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input2'>
      </PVar>
    </ParDecl>
    <ParDecl type='DOUBLE'>
      <PVar hasRef='false'  name='input1'>
      </PVar>
    </ParDecl>
    <Body>
      <FunCallNode name='somma'>
        <IdNode>res1</IdNode>
        <IdNode>input2</IdNode>
        <IdNode>input1</IdNode>
      </FunCallNode>
      <FunCallNode name='sottrazione'>
        <IdNode>res2</IdNode>
        <IdNode>input2</IdNode>
        <IdNode>input1</IdNode>
      </FunCallNode>
      <AssignNode>
        <IdNode>res3</IdNode>
        <FunCallNode name='divisione'>
          <IdNode>input2</IdNode>
          <IdNode>input1</IdNode>
        </FunCallNode>
      </AssignNode>
      <AssignNode>
        <IdNode>res4</IdNode>
        <FunCallNode name='moltiplicazione'>
          <IdNode>input2</IdNode>
          <IdNode>input1</IdNode>
        </FunCallNode>
      </AssignNode>
    </Body>
  </DefDecl>
  <DefDecl name='stampa' type='STRING'>
    <ParDecl type='STRING'>
      <PVar hasRef='false'  name='stringa'>
      </PVar>
    </ParDecl>
    <Body>
      <ReturnNode>
        <AddNode>
          <StringNode>Ciao! </StringNode>
          <IdNode>stringa</IdNode>
        </AddNode>
      </ReturnNode>
    </Body>
  </DefDecl>
  <AssignNode>
    <IdNode>flag</IdNode>
    <BoolNode>true</BoolNode>
  </AssignNode>
  <WhileNode>
    <IdNode>flag</IdNode>
    <Body>
      <WriteNode isNewLine='false'>
        <StringNode>Inserisci l'operazione da effettuare (somma, sottrazione, divisione, moltiplicazione, tutteleoperazioni): </StringNode>
      </WriteNode>
      <ReadNode>
        <IdNode>operazione</IdNode>
      </ReadNode>
      <WriteNode isNewLine='false'>
        <StringNode>Inserisci il primo input: </StringNode>
      </WriteNode>
      <ReadNode>
        <IdNode>input1</IdNode>
      </ReadNode>
      <WriteNode isNewLine='false'>
        <StringNode>Inserisci il secondo input: </StringNode>
      </WriteNode>
      <ReadNode>
        <IdNode>input2</IdNode>
      </ReadNode>
      <WriteNode isNewLine='true'>
        <IdNode>input2</IdNode>
        <StringNode> e </StringNode>
        <IdNode>input1</IdNode>
        <StringNode> con gli argomenti </StringNode>
        <IdNode>operazione</IdNode>
        <StringNode>Hai scelto l'operazione </StringNode>
      </WriteNode>
      <IfThenElseNode>
        <EQNode>
          <IdNode>operazione</IdNode>
          <StringNode>somma</StringNode>
        </EQNode>
        <Body>
          <FunCallNode name='somma'>
            <IdNode>result</IdNode>
            <IdNode>input2</IdNode>
            <IdNode>input1</IdNode>
          </FunCallNode>
        </Body>
        <Body>
          <IfThenElseNode>
            <EQNode>
              <IdNode>operazione</IdNode>
              <StringNode>sottrazione</StringNode>
            </EQNode>
            <Body>
              <FunCallNode name='sottrazione'>
                <IdNode>result</IdNode>
                <IdNode>input2</IdNode>
                <IdNode>input1</IdNode>
              </FunCallNode>
            </Body>
            <Body>
              <IfThenElseNode>
                <EQNode>
                  <IdNode>operazione</IdNode>
                  <StringNode>divisione</StringNode>
                </EQNode>
                <Body>
                  <AssignNode>
                    <IdNode>result</IdNode>
                    <FunCallNode name='divisione'>
                      <IdNode>input2</IdNode>
                      <IdNode>input1</IdNode>
                    </FunCallNode>
                  </AssignNode>
                </Body>
                <Body>
                  <IfThenElseNode>
                    <EQNode>
                      <IdNode>operazione</IdNode>
                      <StringNode>moltiplicazione</StringNode>
                    </EQNode>
                    <Body>
                      <AssignNode>
                        <IdNode>result</IdNode>
                        <FunCallNode name='moltiplicazione'>
                          <IdNode>input2</IdNode>
                          <IdNode>input1</IdNode>
                        </FunCallNode>
                      </AssignNode>
                    </Body>
                    <Body>
                      <IfThenElseNode>
                        <EQNode>
                          <IdNode>operazione</IdNode>
                          <StringNode>tutteleoperazioni</StringNode>
                        </EQNode>
                        <Body>
                          <FunCallNode name='tutteleoperazioni'>
                            <IdNode>res4</IdNode>
                            <IdNode>res3</IdNode>
                            <IdNode>res2</IdNode>
                            <IdNode>res1</IdNode>
                            <IdNode>input2</IdNode>
                            <IdNode>input1</IdNode>
                          </FunCallNode>
                        </Body>
                        <Body>
                          <WriteNode isNewLine='true'>
                            <StringNode>Operazione non consentita</StringNode>
                          </WriteNode>
                        </Body>
                      </IfThenElseNode>
                    </Body>
                  </IfThenElseNode>
                </Body>
              </IfThenElseNode>
            </Body>
          </IfThenElseNode>
        </Body>
      </IfThenElseNode>
      <IfThenElseNode>
        <NENode>
          <IdNode>operazione</IdNode>
          <StringNode>tutteleoperazioni</StringNode>
        </NENode>
        <Body>
          <WriteNode isNewLine='true'>
            <IdNode>result</IdNode>
            <StringNode>Il risultato è: </StringNode>
          </WriteNode>
        </Body>
        <Body>
          <WriteNode isNewLine='true'>
            <FunCallNode name='stampa'>
              <AddNode>
                <StringNode>I risultati delle 4 operazioni sono 
</StringNode>
                <AddNode>
                  <IdNode>res1</IdNode>
                  <AddNode>
                    <StringNode>
</StringNode>
                    <AddNode>
                      <IdNode>res2</IdNode>
                      <AddNode>
                        <StringNode>
</StringNode>
                        <AddNode>
                          <IdNode>res3</IdNode>
                          <AddNode>
                            <StringNode>
</StringNode>
                            <AddNode>
                              <IdNode>res4</IdNode>
                              <StringNode>
</StringNode>
                            </AddNode>
                          </AddNode>
                        </AddNode>
                      </AddNode>
                    </AddNode>
                  </AddNode>
                </AddNode>
              </AddNode>
            </FunCallNode>
          </WriteNode>
        </Body>
      </IfThenElseNode>
      <WriteNode isNewLine='false'>
        <StringNode>Vuoi continuare? (1 yes/0 no): </StringNode>
      </WriteNode>
      <ReadNode>
        <IdNode>answer</IdNode>
      </ReadNode>
      <IfThenElseNode>
        <EQNode>
          <IdNode>answer</IdNode>
          <IntNode>1</IntNode>
        </EQNode>
        <Body>
          <AssignNode>
            <IdNode>flag</IdNode>
            <BoolNode>true</BoolNode>
          </AssignNode>
        </Body>
        <Body>
          <AssignNode>
            <IdNode>flag</IdNode>
            <BoolNode>false</BoolNode>
          </AssignNode>
        </Body>
      </IfThenElseNode>
    </Body>
  </WhileNode>
</Program>
